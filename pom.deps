locked com.smxemail.tiles:com.smxemail.tiles.release:2.1.44 from smx3:smx3.bill-of-materials:3.0.11;
locked com.smxemail:com.smxemail.errorprone.checks:1.0.8 from smx3:smx3.bill-of-materials:3.0.11;
locked com.smxemail:com.smxemail.rangeresolver:1.1.20 from com.smxemail:rangeresolver-maven-plugin:1.1.33;
