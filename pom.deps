// SMX Nexus Repository
repository https://nexus.az1.smxk8s.net/repository/maven-releases/;
repository https://repo1.maven.org/maven2/ as central;

import smx3:smx3.bill-of-materials:3.7.40;

//allow unlocked /^.*smx.*$/;
resolve highest com.smxemail:com.smxemail.rangeresolver:[1.1.44,2.0.0);
resolve highest org.apache.maven.plugins:maven-plugin-plugin:[3.15.1,4.0.0) via central filtering /^.*(alpha|beta|rc|pr|m|SNAPSHOT).*$/;
resolve highest org.apache.maven.plugins:maven-source-plugin:[3.3.1,4.0.0) via central filtering /^.*(alpha|beta|rc|pr|m|SNAPSHOT).*$/;
resolve highest org.apache.maven.plugins:maven-resources-plugin:[3.3.1,4.0.0) via central filtering /^.*(alpha|beta|rc|pr|m|SNAPSHOT).*$/;
resolve highest org.apache.maven.plugins:maven-dependency-plugin:[3.8.1,4.0.0) via central filtering /^.*(alpha|beta|rc|pr|m|SNAPSHOT).*$/;
resolve highest org.apache.maven.plugins:maven-builder-support:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-resolver-provider:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-repository-metadata:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-model-builder:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.shared:maven-filtering:[3.4.0,4.0.0) via central filtering /^.*(alpha|beta|rc|pr|m|SNAPSHOT).*$/;
resolve highest org.apache.maven.scm:maven-scm-manager-plexus:[1.13.0,2.0.0) via central filtering /^.*(alpha|beta|rc|pr|m|SNAPSHOT).*$/;
resolve highest org.apache.maven.scm:maven-scm-api:[1.13.0,2.0.0) via central filtering /^.*(alpha|beta|rc|pr|m|SNAPSHOT).*$/;
resolve highest com.google.truth:truth:[1.4.4,2.0) via central;
resolve highest io.vavr:vavr:[0.10.6,1.0.0) via central filtering /^.*(alpha|beta|rc|pr|m|SNAPSHOT).*$/;

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

locked com.diffplug.spotless:spotless-maven-plugin:2.44.2;
locked com.google.guava:failureaccess:1.0.2;
locked com.google.truth:truth:1.4.4;
locked com.palantir.javaformat:palantir-java-format:2.50.0;
