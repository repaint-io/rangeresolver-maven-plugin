// SMX Nexus Repository
repository https://nexus.az1.smxk8s.net/repository/maven-releases/;
repository https://repo1.maven.org/maven2/ as central;

import smx3:smx3.bill-of-materials:3.5.37-SNAPSHOT;

//allow unlocked /^.*smx.*$/;
resolve highest com.smxemail:com.smxemail.rangeresolver:[1.1.41,2.0.0);
resolve highest org.apache.maven.plugins:maven-plugin-plugin:[3.13.1,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-source-plugin:[3.3.1,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-resources-plugin:[3.3.1,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-dependency-plugin:[3.5.0,4.0.0) via public;
resolve highest org.apache.maven.plugins:maven-builder-support:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-resolver-provider:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-repository-metadata:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-model-builder:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.shared:maven-filtering:[3.3.2,4.0.0) via central;
resolve highest org.apache.maven.scm:maven-scm-manager-plexus:[1.13.0,2.0.0) via central filtering /^.*(alpha|beta|rc|pr|m|SNAPSHOT).*$/;
resolve highest org.apache.maven.scm:maven-scm-api:[1.13.0,2.0.0) via central filtering /^.*(alpha|beta|rc|pr|m|SNAPSHOT).*$/;
resolve highest com.google.truth:truth:[1.4.2,2.0) via central;
resolve highest io.vavr:vavr:[1.0.0-alpha-4,2.0.0) via central;

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

locked com.github.sviperll:adt4j:3.2;
locked com.google.auto.value:auto-value:1.11.0;
locked com.google.guava:failureaccess:1.0.2;
locked com.google.truth:truth:1.4.2;
locked com.smxemail.tiles:com.smxemail.tiles.enforcements:3.2.227;
locked com.smxemail.tiles:com.smxemail.tiles.release:2.2.92;
locked com.smxemail:com.smxemail.datatype.annotations:1.0.4;
locked com.smxemail:com.smxemail.errorprone.checks:1.0.37;
locked com.smxemail:com.smxemail.rangeresolver:1.1.41;
locked io.repaint.maven:tiles-maven-plugin:2.40;
locked io.vavr:vavr:1.0.0-alpha-4;
locked org.antlr:antlr4-runtime:4.9.3;
locked org.apache.maven.plugins:maven-assembly-plugin:3.7.1;
locked org.apache.maven.plugins:maven-failsafe-plugin:3.2.5;
locked org.apache.maven.plugins:maven-install-plugin:3.1.2;
locked org.apache.maven.plugins:maven-jar-plugin:3.4.1;
locked org.apache.maven.plugins:maven-plugin-plugin:3.13.1;
locked org.apache.maven.plugins:maven-resources-plugin:3.3.1;
locked org.apache.maven.plugins:maven-source-plugin:3.3.1;
locked org.apache.maven.plugins:maven-surefire-plugin:3.2.5;
locked org.apache.maven.scm:maven-scm-api:1.13.0;
locked org.apache.maven.scm:maven-scm-manager-plexus:1.13.0;
locked org.apache.maven.shared:maven-filtering:3.3.2;
locked org.apache.maven:maven-artifact:3.9.7;
locked org.codehaus.mojo:build-helper-maven-plugin:3.6.0;
locked org.immutables:value:2.10.1;
locked org.jacoco:jacoco-maven-plugin:0.8.12;
locked org.jdom:jdom2:2.0.6.1;
locked org.junit.jupiter:junit-jupiter-api:5.10.2;
locked org.junit.jupiter:junit-jupiter-engine:5.10.2;
locked org.junit.jupiter:junit-jupiter-params:5.10.2;
