// SMX Nexus Repository
repository https://nexus.az1.smxk8s.net/repository/maven-releases/;
repository https://repo1.maven.org/maven2/ as central;

import smx3:smx3.bill-of-materials:3.4.47-SNAPSHOT;

//allow unlocked /^.*smx.*$/;
resolve highest com.smxemail:com.smxemail.rangeresolver:[1.1.39,2.0.0);
resolve highest org.apache.maven.plugins:maven-plugin-plugin:[3.9.0,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-source-plugin:[3.2.2,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-resources-plugin:[3.3.1,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-dependency-plugin:[3.5.0,4.0.0) via public;
resolve highest org.apache.maven.plugins:maven-builder-support:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-resolver-provider:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-repository-metadata:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.plugins:maven-model-builder:[3.5.0,4.0.0) via central;
resolve highest org.apache.maven.shared:maven-filtering:[3.3.1,4.0.0) via central;
resolve highest org.apache.maven.scm:maven-scm-manager-plexus:[2.0.0,4.0.0) via central;
resolve highest com.google.truth:truth:[1.1.3,2.0) via central;
resolve highest io.vavr:vavr:[1.0.0-alpha-4,2.0.0) via central;

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

locked com.github.sviperll:adt4j:3.2;
locked com.google.auto.value:auto-value:1.10.1;
locked com.google.guava:failureaccess:1.0.1;
locked com.google.truth:truth:1.1.3;
locked com.smxemail.tiles:com.smxemail.tiles.enforcements:3.2.166;
locked com.smxemail.tiles:com.smxemail.tiles.release:2.2.71;
locked com.smxemail:com.smxemail.datatype.annotations:1.0.3;
locked com.smxemail:com.smxemail.errorprone.checks:1.0.37;
locked com.smxemail:com.smxemail.rangeresolver:1.1.39;
locked io.repaint.maven:tiles-maven-plugin:2.36;
locked io.vavr:vavr:1.0.0-alpha-4;
locked org.antlr:antlr4-runtime:4.9.3;
locked org.apache.maven.plugins:maven-assembly-plugin:3.6.0;
locked org.apache.maven.plugins:maven-failsafe-plugin:3.1.0;
locked org.apache.maven.plugins:maven-install-plugin:3.1.1;
locked org.apache.maven.plugins:maven-jar-plugin:3.3.0;
locked org.apache.maven.plugins:maven-plugin-plugin:3.9.0;
locked org.apache.maven.plugins:maven-resources-plugin:3.3.1;
locked org.apache.maven.plugins:maven-source-plugin:3.2.1;
locked org.apache.maven.plugins:maven-surefire-plugin:3.1.0;
locked org.apache.maven.scm:maven-scm-manager-plexus:2.0.0;
locked org.apache.maven.shared:maven-filtering:3.3.1;
locked org.apache.maven:maven-artifact:3.9.2;
locked org.codehaus.mojo:build-helper-maven-plugin:3.4.0;
locked org.immutables:value:2.9.3;
locked org.jacoco:jacoco-maven-plugin:0.8.10;
locked org.jdom:jdom2:2.0.6.1;
locked org.junit.jupiter:junit-jupiter-api:5.9.3;
locked org.junit.jupiter:junit-jupiter-engine:5.9.3;
locked org.junit.jupiter:junit-jupiter-params:5.9.3;
