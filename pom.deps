repository https://repo1.maven.org/maven2/ as central;

resolve highest io.repaint:io.repaint.rangeresolver:[1.2.0,2.0.0);
resolve highest org.antlr:antlr4-runtime:[4.13.2,5.0.0) via central;
resolve highest org.apache.maven.plugins:maven-plugin-plugin:[3.16.0,4.0.0) via central filtering /^.*(alpha|beta|rc|pr|m|SNAPSHOT).*$/;
