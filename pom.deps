// SMX Nexus Repository
repository http://nexus.smxemail.com/nexus/content/repositories/releases/;
repository http://nexus.smxemail.com/nexus/content/groups/public/ as public;

import smx3:smx3.bill-of-materials:3.2.3;

allow unlocked /^.*smx.*$/;

resolve snapshot com.smxemail:com.smxemail.rangeresolver:[1.1.24,2.0.0);
resolve highest com.google.truth:truth:[1.0.1,2.0) via public;
resolve highest io.vavr:vavr:[1.0.0-alpha-3,2.0.0) via public;

override highest com.google.guava:guava:[29.0-jre,30.0) via public filtering /^.*(SNAPSHOT).*$/;

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

