locked com.smxemail.tiles:com.smxemail.tiles.release:2.2.108;
locked com.smxemail:com.smxemail.rangeresolver:1.1.44;
locked io.repaint.maven:tiles-maven-plugin:2.40;
locked io.vavr:vavr:0.10.6;
locked org.antlr:antlr4-runtime:4.9.3;
locked org.apache.maven.plugins:maven-assembly-plugin:3.7.1;
locked org.apache.maven.plugins:maven-dependency-plugin:3.8.1;
locked org.apache.maven.plugins:maven-deploy-plugin:3.1.3;
locked org.apache.maven.plugins:maven-failsafe-plugin:3.5.2;
locked org.apache.maven.plugins:maven-install-plugin:3.1.3;
locked org.apache.maven.plugins:maven-jar-plugin:3.4.2;
locked org.apache.maven.plugins:maven-plugin-plugin:3.15.1;
locked org.apache.maven.plugins:maven-resources-plugin:3.3.1;
