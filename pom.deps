// SMX Nexus Repository
repository http://nexus.smxemail.com/nexus/content/repositories/releases/;
repository http://nexus.smxemail.com/nexus/content/groups/public/ as public;

import smx3:smx3.bill-of-materials:3.0.11;

allow unlocked /^.*smx.*$/;

resolve snapshot com.smxemail:com.smxemail.rangeresolver:[1.1.20,2.0.0);
resolve highest com.google.truth:truth:[0.42,1.0) via public;

override highest com.google.guava:guava:[26.0-jre,30.0) via public filtering /^.*(SNAPSHOT).*$/;
override highest org.antlr:antlr4-maven-plugin:[4.7.1,5.0.0) via public;
override highest org.antlr:antlr4-runtime:[4.7.1,5.0) via public;

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

locked com.github.sviperll:adt4j:3.2 from smx3:smx3.bill-of-materials:2.1.1;
locked com.google.auto.value:auto-value:1.5.2 from smx3:smx3.bill-of-materials:2.1.1;
