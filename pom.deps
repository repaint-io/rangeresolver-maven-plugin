// SMX Nexus Repository
repository https://nexus.az1.smxk8s.net/repository/maven-releases/;
repository http://nexus.smxemail.com/nexus/content/groups/public/ as public;

import smx3:smx3.bill-of-materials:3.3.151;

allow unlocked /^.*smx.*$/;

resolve highest com.smxemail:com.smxemail.rangeresolver:[1.1.35,2.0.0);
resolve highest com.google.truth:truth:[1.1.3,2.0) via public;
resolve highest io.vavr:vavr:[1.0.0-alpha-4,2.0.0) via public;

alias org.immutables:value as immutables.value.version;
alias com.github.spullara.mustache.java:compiler as mustache.compiler.version;

locked com.github.sviperll:adt4j:3.2;
locked com.google.auto.value:auto-value:1.9;
locked com.google.guava:failureaccess:1.0.1;
locked com.google.truth:truth:1.1.3;
locked com.smxemail.tiles:com.smxemail.tiles.enforcements:3.2.127;
locked com.smxemail.tiles:com.smxemail.tiles.release:2.2.45;
locked com.smxemail:com.smxemail.datatype.annotations:1.0.2;
locked com.smxemail:com.smxemail.errorprone.checks:1.0.36;
locked com.smxemail:com.smxemail.rangeresolver:1.1.35;
locked io.repaint.maven:tiles-maven-plugin:2.27;
locked io.vavr:vavr:1.0.0-alpha-4;
locked org.antlr:antlr4-runtime:4.9.3;
locked org.apache.maven.plugins:maven-jar-plugin:3.2.2;
locked org.apache.maven.plugins:maven-source-plugin:3.2.1;
locked org.apache.maven:maven-artifact:3.8.5;
locked org.codehaus.mojo:build-helper-maven-plugin:3.3.0;
locked org.immutables:value:2.9.0;
locked org.jacoco:jacoco-maven-plugin:0.8.8;
locked org.jdom:jdom2:2.0.6.1;
locked org.junit.jupiter:junit-jupiter-api:5.8.2;
locked org.junit.jupiter:junit-jupiter-engine:5.8.2;
locked org.junit.jupiter:junit-jupiter-params:5.8.2;
